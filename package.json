{
  "name": "invoicelint",
  "version": "0.2.0",
  "description": "Check Canadian invoices for the details a buyer needs to claim GST/HST input tax credits, and whether the tax math adds up. JSON and UBL 2.1 (Peppol) input.",
  "license": "MIT",
  "author": "Bosco Sin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larplarp67/invoicelint.git"
  },
  "homepage": "https://github.com/larplarp67/invoicelint#readme",
  "bugs": {
    "url": "https://github.com/larplarp67/invoicelint/issues"
  },
  "keywords": [
    "gst",
    "hst",
    "canada",
    "invoice",
    "validation",
    "e-invoicing",
    "ubl",
    "peppol",
    "input-tax-credit",
    "cra",
    "lint"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema.json": "./schema/invoice.schema.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "invoicelint": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "schema": "node scripts/generate-schema.ts",
    "docs:rules": "node scripts/gen-rules-doc.ts",
    "check:dist": "node scripts/check-dist.ts",
    "test:peppol": "node scripts/fetch-peppol-examples.ts && vitest run test/peppol.test.ts",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepublishOnly": "corepack pnpm build && corepack pnpm test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.12.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
